    <link href="/static/vendor/bootstrap.min.css" rel="stylesheet">
    <link href="/static/vendor/icons/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root {
            --brand: #4f46e5;
            --brand-dark: #4338ca;
            --brand-light: #eef2ff;
            --ink: #1e293b;
            --muted: #64748b;
            --bg: #f8fafc;
        }

        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: var(--bg);
            color: var(--ink);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        h1, h2, h3, h4, h5, .navbar-brand {
            font-family: 'Poppins', sans-serif;
        }

        a { color: var(--brand); text-decoration: none; }
        a:hover { color: var(--brand-dark); }

        /* ---------- Topo / Navbar ---------- */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .top-bar {
            background: #1e1b4b;
            color: #c7d2fe;
            font-size: .85rem;
        }

        .navbar-store {
            background: #fff;
            box-shadow: 0 2px 14px rgba(15, 23, 42, .08);
        }

        .navbar-toggler {
            border: 1px solid #e2e8f0;
            border-radius: .6rem;
            padding: .3rem .55rem;
            font-size: 1.1rem;
        }

        .navbar-toggler:focus {
            box-shadow: 0 0 0 .2rem rgba(79, 70, 229, .15);
        }

        .brand-badge {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .nav-link-store {
            font-weight: 500;
            color: var(--ink);
            padding: .5rem .9rem;
            border-radius: .5rem;
        }

        .nav-link-store:hover, .nav-link-store.active {
            color: var(--brand);
            background: var(--brand-light);
        }

        .dropdown-menu {
            border: 0;
            border-radius: .9rem;
            box-shadow: 0 10px 30px rgba(15, 23, 42, .15);
            padding: .5rem;
        }
        .dropdown-item { border-radius: .5rem; padding: .55rem .9rem; font-size: .95rem; }

        /* ---------- Menu mobile ---------- */
        @media (max-width: 991.98px) {
            .navbar-collapse {
                background: #fff;
                border-radius: .9rem;
                padding: .75rem;
                margin-top: .75rem;
                box-shadow: 0 10px 30px rgba(15, 23, 42, .12);
            }
            .navbar-nav .dropdown-menu {
                position: static !important;
                box-shadow: none;
                background: var(--bg);
                border-radius: .6rem;
            }
            .navbar-nav .nav-item .btn-brand {
                width: 100%;
            }
        }

        /* ---------- Botões ---------- */
        .btn-brand {
            background: var(--brand);
            border-color: var(--brand);
            color: #fff;
            font-weight: 600;
        }
        .btn-brand:hover, .btn-brand:focus {
            background: var(--brand-dark);
            border-color: var(--brand-dark);
            color: #fff;
        }

        .btn-outline-brand {
            border-color: var(--brand);
            color: var(--brand);
            font-weight: 600;
        }
        .btn-outline-brand:hover {
            background: var(--brand);
            border-color: var(--brand);
            color: #fff;
        }

        .text-brand { color: var(--brand) !important; }

        /* ---------- Hero ---------- */
        .hero {
            background: linear-gradient(135deg, #312e81 0%, #6d28d9 55%, #9333ea 100%);
            color: #fff;
            border-radius: 1.25rem;
            position: relative;
            overflow: hidden;
        }
        .hero::after {
            content: '';
            position: absolute;
            right: -80px;
            top: -80px;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .08);
        }
        .hero::before {
            content: '';
            position: absolute;
            right: 40px;
            bottom: -100px;
            width: 240px;
            height: 240px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .06);
        }

        /* ---------- Cards de produto ---------- */
        .product-card {
            border-radius: 1rem;
            overflow: hidden;
            background: #fff;
            transition: transform .22s ease, box-shadow .22s ease;
        }
        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 32px rgba(15, 23, 42, .14) !important;
        }
        .product-card img {
            height: 220px;
            width: 100%;
            object-fit: cover;
            transition: transform .35s ease;
        }
        .product-card:hover img { transform: scale(1.06); }

        .category-badge {
            background: var(--brand-light);
            color: var(--brand);
            font-weight: 600;
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .product-price {
